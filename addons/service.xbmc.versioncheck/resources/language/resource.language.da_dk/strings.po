msgctxt "Addon Summary"
msgid "Manitux Version Check checks if you are running latest released version."
msgstr "Manitux Version Check undersøger om du benytter den nyeste version."

msgctxt "Addon Description"
msgid "Manitux Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the manitux.tv website."
msgstr "Manitux Version Check kan kun undersøge for opdateringer for visse platforme/udgaver, da udgivelserne kan variere mellem dem. For mere information, besøg manitux.tv."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit manitux.tv"
msgstr "Du er velkommen til at bruge dette script. For information, besøg manitux.tv"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Vi vil gerne anbefale dig at opgradere."

msgctxt "#32002"
msgid "Visit Manitux.tv for more information."
msgstr "Besøg Manitux.tv for mere information."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Ønsker du at fjerne denne påmindelse?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Du kan slå den til/fra i add-on-indstillingerne."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Benyt din pakkehåndtering (apt) til at opgradere."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Ny version er tilgængelig. Ønsker du at opdatere?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Opdatering lykkedes"

msgctxt "#32014"
msgid "Do you want to restart Manitux to finish the upgrade?"
msgstr "Ønsker du at genstarte Manitux for at afslutte opgraderingen?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Ønsker du at undersøge fjernlageret efter ny version?"

msgctxt "#32016"
msgid "There is a newer stable Manitux version available."
msgstr "Der er en nyere stabil version af Manitux tilgængelig."

msgctxt "#32020"
msgid "General"
msgstr "Generelt"

msgctxt "#32021"
msgid "Enable Manitux version check?"
msgstr "Aktiver tjek for opdateringer af Manitux?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Indtast venligst din adgangskode"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: opgrader hele systemet"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: opgrader ved brug af apt"

#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Manitux is available."
msgstr "Der er en ny stabil version af Manitux tilgængelig."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://manitux.tv for more information."
msgstr "Besøg http://manitux.tv for mere information."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Manitux is available."
msgstr "Der er en ny stabil version af Manitux tilgængelig."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://manitux.tv for more information."
msgstr "Besøg http://manitux.tv for mere information."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Du benytter %s, mens %s er tilgængelig."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Det anbefales at du opdaterer til en nyere version."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Din version %s af Python-kryptografimodulet er for gammel. Du har mindst brug for version 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Opgrader venligst dit operativsystem."

msgctxt "#32042"
msgid "For more information, see https://manitux.wiki/view/Linux"
msgstr "For yderligere information, se https://manitux.wiki/view/Linux"

#~ msgctxt "#32035"
#~ msgid "It is recommended that you to upgrade to a newer version."
#~ msgstr "Det anbefales at du opdaterer til en nyere version."
