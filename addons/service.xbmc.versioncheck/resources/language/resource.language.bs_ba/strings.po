msgctxt "Addon Summary"
msgid "Manitux Version Check checks if you are running latest released version."
msgstr "Manitux Verzijski Provjerač provjerava imate li najnoviju izdanu verziju."

msgctxt "Addon Description"
msgid "Manitux Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the manitux.tv website."
msgstr "Manitux Verzijski Provjerač podržava samo određeni broj platformi/distribucija jer njihova izdanja se međusobno mogu razlikovati. Za više informacija posjetite manitux.tv web stranicu."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit manitux.tv"
msgstr "Slobodno koristite ovu skriptu ako želite. Za više informacija posjetite manitux.tv"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Preporučili bi vam da nadogradite."

msgctxt "#32002"
msgid "Visit Manitux.tv for more information."
msgstr "Posjetite Manitux.tv za više informacija."

# empty strings from id 32003 to 32008
msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Želite li ukloniti ovaj podsjetnik?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Možete ga uključiti/isključiti u opcijama za dodatke."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Koristite vaš upravitelj paketa (apt) za nadogradnju."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Nova verzija je dostupna, želite li odmah nadograditi?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Nadogradnja je uspješna"

msgctxt "#32014"
msgid "Do you want to restart Manitux to finish the upgrade?"
msgstr "Želite li ponovo pokrenuti Manitux da bi ste završili nadogradnju?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Želite li provjeriti u repozitoriju je li dostupna nova verzija?"

msgctxt "#32016"
msgid "There is a newer stable Manitux version available."
msgstr "Dostupna je nova stabilna verzija Manituxja."

msgctxt "#32020"
msgid "General"
msgstr "Opće"

msgctxt "#32021"
msgid "Enable Manitux version check?"
msgstr "Ulključite Manitux Verzijski Provjerač?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Unesite svoju šifru"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Nadogradite cijeli sistem"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Nadogradite pomoću apt-a"

# empty strings from id 32025 to 32029
#. Used in OK dialog
msgctxt "#32030"
msgid "A new stable version of Manitux is available."
msgstr "Nova stabilna verzija Manituxja je dostupna."

#. Direct people to the website. Used in OK dialog
msgctxt "#32031"
msgid "Visit http://manitux.tv for more information."
msgstr "Za više informacija posjetite http://manitux.tv."

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Manitux is available."
msgstr "Nova stabilna verzija Manituxja je dostupna."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://manitux.tv for more information."
msgstr "Za više informacija posjetite http://manitux.tv."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Koristite %s verziju dok je dostupna %s verzija."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Preporučeno je da nadogradite na noviju verziju."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Vaša verzija %s Python kriptografskog modula je prestara. Potrebna je najmanje 1.7 verzija."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Molim vas da nadogradite vaš operativni sistem."

msgctxt "#32042"
msgid "For more information, see https://manitux.wiki/view/Linux"
msgstr "Za više informacija, posjetite https://manitux.wiki/view/Linux"
